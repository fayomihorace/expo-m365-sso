# Environment Variables Configuration

# Microsoft OAuth Configuration
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=your_microsoft_client_id
EXPO_PUBLIC_MICROSOFT_TENANT_ID=your_microsoft_tenant_id
EXPO_PUBLIC_MICROSOFT_REDIRECT_URI=your_redirect_uri

# Backend API Configuration
EXPO_PUBLIC_BACKEND_URL=https://your-backend-api.com

# Expo Project Configuration (for notifications)
# This is your Expo project slug from app.json, or get it from:
# - Run: npx expo config --type public | grep projectId
# - Or use the "slug" value from app.json (e.g., "infraneo-agdt")
# - Or visit: https://expo.dev (find your project ID in the dashboard)
# See GET_PROJECT_ID.md for detailed instructions
EXPO_PUBLIC_PROJECT_ID=your_expo_project_slug
