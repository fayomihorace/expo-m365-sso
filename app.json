{
  "expo": {
    "name": "Infraneo AGDT",
    "slug": "infraneo-agdt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.infraneo.agdt",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "eas": {
        "projectId": "YOUR_EXPO_PROJECT_UUID_HERE"
      }
    },
    "updates": {
      "enabled": false
    },
    "android": {
      "package": "com.infraneo.agdt",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.infraneo.agdt",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "sounds": [],
          "mode": "production",
          "android": {
            "useNextNotificationsApi": true
          },
          "ios": {
            "iosDisplayInForeground": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "packagerOpts": {
      "host": "localhost",
      "port": 8081
    }
  }
}
